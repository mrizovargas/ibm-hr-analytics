    <datasource caption='Consulta SQL personalizada (ibm_hr_analytics) (2)' inline='true' name='federated.1l0ha240xkg9ds1elinev09r6sku' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='localhost' name='postgres.08vng6g0fbqcgt19xve7a03yip0m'>
            <connection authentication='username-password' class='postgres' dbname='ibm_hr_analytics' one-time-sql='' port='5432' server='localhost' username='postgres' />
          </named-connection>
        </named-connections>
        <relation connection='postgres.08vng6g0fbqcgt19xve7a03yip0m' name='Consulta SQL personalizada' type='text'>-- Selección de datos: ID, departamento, rol e ingreso&#13;
SELECT&#13;
    e.employee_number,&#13;
    j.department,&#13;
    j.job_role,&#13;
    e.monthly_income&#13;
&#13;
-- Tabla de hechos de empleados&#13;
FROM fact_employees AS e&#13;
&#13;
-- Cruce con dimensión de puestos por ID de puesto&#13;
INNER JOIN dim_jobs AS j&#13;
    ON e.job_id = j.job_id&#13;
&#13;
-- Filtro por departamento de Ventas&#13;
WHERE j.department = &apos;Sales&apos;</relation>
